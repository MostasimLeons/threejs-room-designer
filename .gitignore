# Dependencies (re-created by `npm install`)
node_modules/

# Build output (re-created by `npm run build`)
dist/
dist-ssr/
*.tsbuildinfo

# Secrets and local environment settings: never commit these
.env
.env.*
!.env.example
*.local
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage / caches
coverage/
.cache/
.vite/
.eslintcache

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# Claude Code: personal settings stay local (launch.json is shared on purpose)
.claude/settings.local.json

# Original downloaded 3D models (large). Optimised copies live in public/models/.
assets-src/
